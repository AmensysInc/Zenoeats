# Zenoeats development settings. `make setup` copies this to .env (git-ignored).
# Fill in the two REQUIRED values; everything else is optional.
# Every other setting has a default, explained in backend/app/config.py.

ENV=development
ROOT_DOMAIN=zenoeats.local

# REQUIRED: from `make key`. Replacing it later makes stored pickup PINs unreadable.
FIELD_ENCRYPTION_KEY=
# REQUIRED: from `openssl rand -base64 32`.
SESSION_SECRET=
# Super admin sign-in, from `python scripts/hash_password.py you@example.com`
# run in backend/. Separate several with ";".
ADMIN_USERS=

# Database and Redis, for `make api` and `make worker`
POSTGRES_PASSWORD=postgres_dev_pw
DATABASE_URL_APP=postgresql+psycopg2://zenoeats_app:app_dev_pw@127.0.0.1:5433/zenoeats
DATABASE_URL_SYSTEM=postgresql+psycopg2://zenoeats_system:system_dev_pw@127.0.0.1:5433/zenoeats
DATABASE_URL_MIGRATE=postgresql+psycopg2://zenoeats_migrate:migrate_dev_pw@127.0.0.1:5433/zenoeats
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_RUNTIME_URL=redis://127.0.0.1:6380/0

# The same, from inside Docker, for `make up-all`
DOCKER_DATABASE_URL_APP=postgresql+psycopg2://zenoeats_app:app_dev_pw@postgres:5432/zenoeats
DOCKER_DATABASE_URL_SYSTEM=postgresql+psycopg2://zenoeats_system:system_dev_pw@postgres:5432/zenoeats
DOCKER_DATABASE_URL_MIGRATE=postgresql+psycopg2://zenoeats_migrate:migrate_dev_pw@postgres:5432/zenoeats
DOCKER_CELERY_BROKER_URL=redis://redis-broker:6379/0
DOCKER_CELERY_RESULT_BACKEND=redis://redis-broker:6379/1
DOCKER_REDIS_RUNTIME_URL=redis://redis-runtime:6379/0

# Links in emails and social sign-in callbacks; development goes through nginx
STOREFRONT_URL_TEMPLATE=https://{slug}.{root_domain}:8443
PLATFORM_URL_TEMPLATE=https://{root_domain}:8443

# Social sign-in: each button appears once its values are set (README, section 3)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# The .p8 contents on one line, with literal \n between its lines
APPLE_OAUTH_PRIVATE_KEY=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# Stripe test keys. The webhook secret comes from
# `stripe listen --forward-connect-to localhost:8000/api/v1/webhooks/stripe/connect`
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# SendGrid. Empty key = nothing is sent. EMAIL_FROM must be a verified sender.
SENDGRID_API_KEY=
EMAIL_FROM=Zenoeats <you@example.com>
EMAIL_REPLY_TO=

# Google Maps, for delivery. Server key: Geocoding and Routes APIs.
# Browser key: Maps JavaScript and Places (Legacy) APIs.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# google, or nominatim (free; NOMINATIM_CONTACT is then required)
GEOCODING_PROVIDER=google
NOMINATIM_CONTACT=

# Sentry. Empty = off.
SENTRY_DSN=

# The address containers reach this machine on. Docker Desktop's is the default;
# OrbStack needs 0.250.250.254.
HOST_GATEWAY_IP=
