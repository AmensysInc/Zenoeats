# Staging edge, behind the VPS reverse proxy.
#
# The host nginx (infra/nginx/staging/vps-stg9.conf) terminates TLS for
# stg9.zenoeats.com and *.stg9.zenoeats.com and proxies here over plain HTTP.
# This container therefore listens on port 80 only, and it does not redirect
# to HTTPS: that redirect is the host's job. Doing it here would loop.
#
# Rendered by the nginx image at start. ${ROOT_DOMAIN} comes from the
# container environment. $host and the other nginx variables are left as-is.

server_tokens off;

log_format zenoeats_noquery '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" $status '
                            '$body_bytes_sent "$http_user_agent" rt=$request_time';

upstream zenoeats_api {
    server api:8000;
    keepalive 32;
}

upstream zenoeats_web {
    server web:3000;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${ROOT_DOMAIN} *.${ROOT_DOMAIN};
    access_log /var/log/nginx/access.log zenoeats_noquery;

    client_max_body_size 8m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    # The host proxy is the only client (bound to 127.0.0.1). Keep the
    # visitor address and the https scheme it already set. Overwriting them
    # with this container's peer would record every customer as the proxy.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Zenoeats-Restaurant "";

    location /api/ {
        proxy_pass http://zenoeats_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    location /images/ {
        proxy_pass http://zenoeats_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location ^~ /health {
        proxy_pass http://zenoeats_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }

    location ^~ /admin {
        if ($host != admin.${ROOT_DOMAIN}) {
            return 404;
        }
        proxy_pass http://zenoeats_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://zenoeats_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
