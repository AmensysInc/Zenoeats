# Staging edge, behind the VPS reverse proxy.
#
# The host nginx (infra/nginx/staging/vps-stg9.conf) terminates TLS for
# stg9.zenoeats.com and *.stg9.zenoeats.com and proxies here over plain HTTP.
# This container listens on port 80 only and does not redirect to HTTPS.
#
# Docker's DNS (127.0.0.11) is queried on each request. A static upstream
# would keep the API container's old address after a recreate and answer 502.
#
# ${ROOT_DOMAIN} is filled from the container environment at start. Nginx
# variables ($host and the rest) are left as-is.

server_tokens off;

log_format zenoeats_noquery '$remote_addr - $remote_user [$time_local] '
                            '"$request_method $uri $server_protocol" $status '
                            '$body_bytes_sent "$http_user_agent" rt=$request_time';

resolver 127.0.0.11 ipv6=off valid=10s;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${ROOT_DOMAIN} *.${ROOT_DOMAIN};
    access_log /var/log/nginx/access.log zenoeats_noquery;

    client_max_body_size 8m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    # Any proxy_set_header in a location replaces the server-level set, so
    # each location repeats the visitor headers itself.
    location /api/ {
        set $zenoeats_api api:8000;
        proxy_pass http://$zenoeats_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Zenoeats-Restaurant "";
        proxy_read_timeout 30s;
    }

    location /images/ {
        set $zenoeats_api api:8000;
        proxy_pass http://$zenoeats_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location ^~ /health {
        set $zenoeats_api api:8000;
        proxy_pass http://$zenoeats_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        access_log off;
    }

    location ^~ /admin {
        set $zenoeats_web web:3000;
        if ($host != admin.${ROOT_DOMAIN}) {
            return 404;
        }
        proxy_pass http://$zenoeats_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location / {
        set $zenoeats_web web:3000;
        proxy_pass http://$zenoeats_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
