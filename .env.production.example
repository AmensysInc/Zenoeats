# =========================================================================
#  Zenoeats -- PRODUCTION settings
# =========================================================================
#
# The template for the .env on a production (or staging) server, which
# docker-compose.prod.yml reads. Do not copy it by hand. On the server, in
# the repository, run once:
#
#   python3 scripts/make_prod_env.py --domain zenoeats.com --release v1.0.0
#   python3 scripts/make_prod_env.py --staging --domain staging.zenoeats.com --release v1.0.0
#
# It writes .env from this file with every secret freshly generated, the
# domain and image tags filled in, and each value only your accounts can
# supply left empty under a "# FILL IN:" line. Then fill those in and check:
#
#   python3 scripts/make_prod_env.py --check .env
#
# Nothing here is a real secret: this file is committed. The .env it makes
# is readable by its owner only, and must be escrowed (a password manager,
# not the server alone): FIELD_ENCRYPTION_KEY cannot be recovered from
# anywhere else, and without it every encrypted pickup PIN is unreadable.
#
# The step-by-step setup of each account below is in the README, "Going to
# production", and docs/operations/STEPS_BEFORE_PRODUCTION.md.

# ---- Platform -----------------------------------------------------------
ENV=production
# Your domain. Restaurants are served at <slug>.<domain>, the super admin at
# admin.<domain>. DNS needs @, * and admin pointing at the server.
ROOT_DOMAIN=
LOG_LEVEL=INFO

# ---- Release ------------------------------------------------------------
# The images CI published for the release tag. Never built on the server.
API_IMAGE=ghcr.io/<owner>/zenoeats/api:<tag>
WEB_IMAGE=ghcr.io/<owner>/zenoeats/web:<tag>
# The same tag, attached to every error report.
RELEASE=

# ---- Database and Redis passwords ---------------------------------------
# Generated by make_prod_env.py (`openssl rand -hex 32` by hand): hex, because
# docker-compose.prod.yml splices them into connection URLs unescaped. It
# builds every DATABASE_URL_* and Redis URL from these, so none is set here.
#
# The three role passwords are applied by infra/postgres/01-roles.sql when the
# database volume is first created. Changing one afterwards needs an
# ALTER ROLE in Postgres as well, or the service using it can no longer log in.
POSTGRES_PASSWORD=
ZENOEATS_MIGRATE_PASSWORD=
ZENOEATS_APP_PASSWORD=
ZENOEATS_SYSTEM_PASSWORD=
REDIS_BROKER_PASSWORD=
REDIS_RUNTIME_PASSWORD=

# ---- Secrets ------------------------------------------------------------
# Generated by make_prod_env.py. Encrypts pickup PINs at rest. Escrow it;
# never replace it on a live system.
FIELD_ENCRYPTION_KEY=
# Generated. Signs admin, staff and guest session cookies; at least 32
# characters. Rotating it signs everyone out.
SESSION_SECRET=

# ---- Platform administrators --------------------------------------------
# "email:hash" entries separated by ";", from
#   docker run --rm -it <API_IMAGE> python scripts/hash_password.py you@example.com
# The API refuses to start with this empty. A change takes effect on each
# admin's next request; recreate the api container to load a new value.
ADMIN_USERS=
ADMIN_SESSION_TTL_MINUTES=480
STAFF_SESSION_TTL_MINUTES=720
# GUEST_SESSION_TTL_MINUTES=43200
# GUEST_RETENTION_DAYS=45

# ---- Clerk (customer sign-in) -------------------------------------------
# A Clerk PRODUCTION instance on your domain, not the development one.
# Clerk > API keys: sk_live_..., pk_live_..., the JWKS URL and the Frontend
# API URL (the issuer, e.g. https://clerk.<domain>).
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
# Handed to the web container at start; changing it needs a restart, not a
# rebuild.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk > Webhooks > endpoint https://<domain>/api/v1/webhooks/clerk
# with user.created, user.updated and user.deleted (and email.created, to
# send Clerk's own emails through SendGrid -- README, "Email"): the signing
# secret.
CLERK_WEBHOOK_SECRET=
# Always false. The API refuses to start in production with it on.
AUTH_DEV_BYPASS=false

# ---- Stripe (payments) --------------------------------------------------
# LIVE mode keys: sk_live_ and pk_live_. The API refuses test keys unless
# ALLOW_TEST_KEYS=true, which is for staging only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe > Developers > Webhooks, a CONNECT endpoint at
# https://<domain>/api/v1/webhooks/stripe/connect listening
# for payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled, charge.refunded and account.updated.
STRIPE_CONNECT_WEBHOOK_SECRET=
ALLOW_TEST_KEYS=false
# Zenoeats' fee per order: basis points (250 = 2.5%) plus fixed cents.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_MINOR=0

# ---- Email (SendGrid) ---------------------------------------------------
# Every email Zenoeats sends goes through SendGrid from the worker. Empty key
# = none are sent, and the portal says so.
#
# SendGrid > Settings > Sender Authentication > Authenticate Your Domain
# (its CNAME records in DNS, unproxied), then Settings > API Keys with Mail
# Send access only.
SENDGRID_API_KEY=
# A sender on the authenticated domain.
EMAIL_FROM=Zenoeats <orders@your-domain>
# An inbox someone reads; customers reply to order emails.
EMAIL_REPLY_TO=
STOREFRONT_URL_TEMPLATE=https://{slug}.{root_domain}

# ---- Google Maps (delivery) ---------------------------------------------
# Server key: Geocoding API and Routes API, restricted to the server's IP.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API and Places API (Legacy), restricted to
# https://*.<domain>/* referrers.
GOOGLE_MAPS_BROWSER_KEY=
GEOCODING_PROVIDER=google
GEOCODE_CACHE_TTL_SECONDS=2592000
GEOCODE_TIMEOUT_SECONDS=4
# DRIVER_LOCATION_STALE_SECONDS=120
# DELIVERY_ETA_REFRESH_SECONDS=30
# ROUTES_TIMEOUT_SECONDS=4

# ---- Orders -------------------------------------------------------------
PENDING_PAYMENT_TTL_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24
WEBHOOK_EVENT_RETENTION_DAYS=365
# MAX_ITEMS_PER_ORDER=50

# ---- Images -------------------------------------------------------------
# Uploaded menu images are kept in the repository's images/ folder on the
# server, which backups include. Set IMAGES_PUBLIC_BASE only when they move
# to object storage, e.g. https://images.<domain>; stored keys do not change.
# IMAGES_PUBLIC_BASE=/images

# ---- Web container ------------------------------------------------------
# Extra https:// origins images may load from (space-separated), e.g. the
# object storage domain above. "true" reports policy violations without
# blocking them, while trying a change.
# CSP_EXTRA_IMG_SRC=
# CSP_REPORT_ONLY=false

# ---- Server shape -------------------------------------------------------
# uvicorn processes in the api container. Each opens its own database pools:
# (DB_POOL_SIZE + DB_MAX_OVERFLOW + 10) x API_WORKERS, plus the worker's, must
# fit under Postgres' max_connections (100).
API_WORKERS=2
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# The edge nginx has a fixed address, so the api trusts forwarding headers
# from exactly that container. Change both only if the subnet is taken.
# EDGE_SUBNET=172.31.250.0/24
# EDGE_IP=172.31.250.10
# Where fullchain.pem and privkey.pem for <domain> and *.<domain> live.
# TLS_CERT_DIR=./infra/certs
# Container limits, sized for a 2 vCPU / 4 GB VM. Raise them on a bigger one.
# API_MEM_LIMIT=1g
# API_CPUS=1.5
# WORKER_MEM_LIMIT=768m
# WORKER_CPUS=1.0
# BEAT_MEM_LIMIT=256m
# WEB_MEM_LIMIT=128m
# NGINX_MEM_LIMIT=128m
# REDIS_RUNTIME_MEM_LIMIT=320m
# MIGRATE_MEM_LIMIT=512m

# ---- Error tracking -----------------------------------------------------
# Sentry project DSN. Recommended: without it a production error is only in
# the container log.
SENTRY_DSN=
# production, or staging on a staging server.
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
