# Zenoeats production settings. Do not copy by hand; on the server run:
#   python3 scripts/make_prod_env.py --domain zenoeats.com --release v1.0.0
#   python3 scripts/make_prod_env.py --check .env
# Add --staging to the first for a staging server. Keep a copy of the result in
# a password manager: FIELD_ENCRYPTION_KEY cannot be recovered from anywhere else.
# Every other setting has a default, explained in backend/app/config.py and
# docs/operations/STEPS_BEFORE_PRODUCTION.md.

ENV=production
ROOT_DOMAIN=
ALLOW_TEST_KEYS=false

# The images CI published for the release tag
API_IMAGE=ghcr.io/<owner>/zenoeats/api:<tag>
WEB_IMAGE=ghcr.io/<owner>/zenoeats/web:<tag>
RELEASE=
API_WORKERS=2

# Generated. Hex only: they are spliced into connection URLs unescaped.
POSTGRES_PASSWORD=
ZENOEATS_MIGRATE_PASSWORD=
ZENOEATS_APP_PASSWORD=
ZENOEATS_SYSTEM_PASSWORD=
REDIS_BROKER_PASSWORD=
REDIS_RUNTIME_PASSWORD=

# Generated. Never replace FIELD_ENCRYPTION_KEY on a live system.
FIELD_ENCRYPTION_KEY=
SESSION_SECRET=

# Super admin sign-in: "email:hash" entries separated by ";", from
#   docker run --rm -it <API_IMAGE> python scripts/hash_password.py you@example.com
ADMIN_USERS=

# Social sign-in: each button appears once its values are set (README, section 3)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# The .p8 contents on one line, with literal \n between its lines
APPLE_OAUTH_PRIVATE_KEY=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# Stripe live keys. The webhook secret is from a CONNECT endpoint at
# https://<domain>/api/v1/webhooks/stripe/connect
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Zenoeats' fee per order: basis points (250 = 2.5%) plus fixed cents
PLATFORM_FEE_BPS=0
PLATFORM_FEE_FIXED_MINOR=0

# SendGrid. Empty key = nothing is sent. EMAIL_FROM must be on the authenticated domain.
SENDGRID_API_KEY=
EMAIL_FROM=Zenoeats <orders@your-domain>
EMAIL_REPLY_TO=
STOREFRONT_URL_TEMPLATE=https://{slug}.{root_domain}

# Google Maps. Server key restricted to this server's IP; browser key to
# https://*.<domain>/*
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GEOCODING_PROVIDER=google

# Sentry. Without it a production error is only in the container log.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
