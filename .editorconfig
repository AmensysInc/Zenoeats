# Keeps every editor writing files the way this repository already has them.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,sql}]
indent_size = 4

[*.{conf,template}]
indent_size = 4

[Makefile]
indent_style = tab

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
