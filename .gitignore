.env
*.pyc
__pycache__/
.venv/
node_modules/
*.egg-info/
.pytest_cache/
.DS_Store
.clerk/
# TLS certificates and keys for the production edge. Never committed.
/infra/certs/
dist/
*.tsbuildinfo

# Uploaded menu images. The folder is tracked, its contents are not.
/images/*
!/images/.gitkeep

# Design-system snapshot for importing into Claude Design. Local only.
/DESIGN_CONTEXT.md

# Redesign reference package (handoff docs, component library, generated
# images): about 100 MB of design material, not app code. Kept locally and
# never published -- the repository is public, and git keeps every byte
# forever. web/qa/references.mjs reads it from here.
/docs/design/design/

# Claude Code's per-machine permissions for this project.
/.claude/

# Local screenshots, run logs and verification evidence. Everything under
# artifacts/ is produced by a local run, so none of it is source.
/artifacts/
# Local HTTPS certificate for *.zenoeats.local (see README). Never committed.
/infra/certs-local/
